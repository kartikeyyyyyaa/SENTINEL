# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password

# The least-privilege role the API actually connects as. It is created by
# db/bootstrap/00-app-role.sh on first container init and deliberately has
# neither SUPERUSER nor BYPASSRLS, so Row-Level Security applies to it.
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=CHANGE_ME_app_role_password

# --- Application secrets ----------------------------------------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_long_random_string

# Base64 of 32 random bytes. Wraps the per-camera data keys used to encrypt
# camera credentials. In production this comes from an HSM/KMS, not a file.
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_MASTER_KEY=CHANGE_ME_base64_32_bytes

# --- Tokens and lockout -----------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Service ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated exact origins. No wildcards: credentials are sent cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=120

# --- Sentinel sandbox camera grid ------------------------------------------
# Host of the hackathon camera grid, used by the catalogue sync.
# Verify reachability first:  curl -s http://<host>/api/ingest
SANDBOX_BASE_URL=
SANDBOX_SYNC_ENABLED=false
